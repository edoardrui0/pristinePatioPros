			}

			.cs-item {
				list-style: none;
				width: 100%;
				box-sizing: border-box;
				/* 40px - 60px top & bottom,  20px - 48px left & right, */
				padding: clamp(2.5rem, 4.1vw, 3.125rem) clamp(1.25rem, 3.4vw, 2rem);
				background-color: var(--backgroundBreakBlue);
				grid-column: span 12;
				transition:
					transform 0.3s,
					box-shadow 0.3s;
				border: 2px solid black;
				border-radius: 0.75rem;
				box-shadow: 10px 10px 0px -4px #000000;

				&:hover {
					transform: translateY(-1rem);
					box-shadow: rgba(149, 157, 165, 0.1) 0px 8px 24px;
				}
			}

			.cs-link {
				text-decoration: none;
				display: flex;
				flex-direction: column;
				justify-content: center;
				/* set text align to center if content needs to be centrally aligned */
				text-align: left;
			}

			.cs-step {
				font-size: var(--topperFontSize);
				line-height: 1.2em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				/* 48px - 100px */
				margin-bottom: clamp(3rem, 7.8vw, 6.25rem);
				color: var(--primary);
				display: block;
				text-align: inherit;
			}

			.cs-h3 {
				font-size: (20/16rem);
				line-height: 1.2em;
				font-weight: 900;
				margin: 0;
				margin-bottom: (12/16rem);
				color: var(--whiteText);
				transition: color 0.3s;
				text-align: inherit;
				border-bottom: 2px solid white;
				padding-bottom: 8px;
			}

			.cs-item-text {
				/* 14px - 16px */
				font-size: clamp(0.875rem, 1.5vw, 1rem);
				font-weight: 900;
				line-height: 1.5em;
				margin: 0;
				color: var(--whiteText);
				transition: color 0.3s;
				text-align: inherit;
			}
		}
	}

	/* Tablet - 768px */
	@media only screen and (min-width: 48rem) {
		#services-1331 {
			.cs-container {
				max-width: (1280/16rem);
			}

			.cs-content {
				flex-direction: row;
				justify-content: space-between;
				align-items: flex-end;
				/* 48px - 80px */
				gap: clamp(3rem, 6vw, 5rem);
				text-align: left;
			}

			.cs-title {
				margin: 0;
			}

			.cs-flex-group {
				width: 50%;
			}

			.cs-card-group {
				flex-direction: row;
				justify-content: space-between;
				flex-wrap: wrap;
				column-gap: (16/16rem);
			}

			.cs-item {
				grid-column: span 4;
			}
		}
	}

	/* Dark Mode */
	@media only screen and (min-width: 0rem) {
		body.dark-mode {
			#services-1331 {
				background-color: rgba(0, 0, 0, 0.2);

				.cs-topper {
					color: var(--primaryLight);
				}
				.cs-title,
				.cs-text,
				.cs-h3,
				.cs-item-text {
					color: var(--bodyTextColorWhite);
				}

				.cs-text,
				.cs-item-text {
					opacity: 0.8;
				}

				.cs-item {
					background-color: var(--medium);
				}
			}
		}
	}
</style>

