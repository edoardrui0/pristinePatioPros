					}
				}
			}

			.cs-picture {
				display: block;
				position: relative;
				z-index: 1;

				img {
					width: 100%;
					height: 100%;
					object-fit: cover;
					position: absolute;
					top: 0;
					left: 0;
					box-shadow: 10px 10px 0px -4px #000000;
					border-radius: 0.75rem;
				}
			}

			.cs-picture1 {
				width: 100%;
				/* 280px - 400px */
				height: clamp(17.5rem, 55vw, 25rem);
			}

			.cs-picture2 {
