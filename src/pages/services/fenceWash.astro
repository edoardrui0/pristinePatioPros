			}

			.cs-phone {
				font-size: (25/16rem);
				font-weight: 700;
				line-height: 1.2em;
				margin: 0;
				color: var(--headerColor);
				display: block;
			}

			.cs-img {
				width: (60/16rem);
				height: auto;
			}

			.cs-signature {
				width: auto;
				height: (36/16rem);
