			.cs-icon {
				width: (24/16rem);
				height: auto;
				display: block;
			}

			.cs-info {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: (4/16rem);
			}

			.cs-link-content {
				font-size: (16/16rem);
				font-weight: 400;
				line-height: 1.2em;
				margin: 0;
				color: var(--bodyTextColor);
